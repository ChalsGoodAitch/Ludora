#: patterns/not-found.php:12
msgid "Use the search below to find your way back to something lovely."
msgstr "Utiliza el buscador para encontrar lo que buscas."

#: patterns/play-park.php
msgctxt "Pattern title"
msgid "Play park homepage"
msgstr "Inicio de parque de juegos"

#: patterns/play-park.php:15
msgid "Little people. Big adventures."
msgstr "Pequeñas personas. Grandes aventuras."

#: patterns/play-park.php:16
msgid "A little imagination, a lot of laughter. Make room for your next family celebration."
msgstr "Un poco de imaginación, muchas risas. Haz espacio para tu próxima celebración familiar."

