msgstr "Páginas de inicio de Ludora"

#: patterns/birthday-experiences.php
msgctxt "Pattern title"
msgid "Birthday experiences homepage"
msgstr "Inicio de experiencias de cumpleaños"

#: patterns/birthday-experiences.php:14
#: patterns/celebration-room.php:14
#: patterns/play-park.php:14
msgid "A SPACE FOR HAPPY MEMORIES"
msgstr "UN ESPACIO PARA RECUERDOS FELICES"

#: patterns/birthday-experiences.php:15
msgid "A birthday as bright as they are."
msgstr "Un cumpleaños lleno de luz."

#: patterns/birthday-experiences.php:16
msgid "From the first happy hello to the last slice of cake, make a day to remember."
msgstr "Desde el primer saludo hasta el último trozo de tarta, crea un día para recordar."

#: patterns/birthday-experiences.php:17
#: patterns/celebration-room.php:17
#: patterns/play-park.php:17
msgid "Explore the possibilities"
msgstr "Descubre las posibilidades"

#: patterns/birthday-experiences.php:20
#: patterns/celebration-room.php:20
#: patterns/play-park.php:20
msgid "MAKE THE DAY YOURS"
msgstr "UN DÍA A TU MEDIDA"

#: patterns/birthday-experiences.php:21
#: patterns/celebration-room.php:21
#: patterns/play-park.php:21
msgid "More together. More to remember."
msgstr "Más momentos juntos. Más recuerdos."

#: patterns/birthday-experiences.php:22
#: patterns/celebration-room.php:22
#: patterns/play-park.php:22
msgid "Create a celebration that feels like you, with space to play, gather and enjoy the little moments."
msgstr "Crea una celebración a tu medida, con espacio para jugar, reunirse y disfrutar de los pequeños momentos."

#: patterns/birthday-experiences.php:23
#: patterns/celebration-room.php:23
#: patterns/play-park.php:23
msgid "Room to play"
msgstr "Espacio para jugar"

#: patterns/birthday-experiences.php:23
#: patterns/celebration-room.php:23
#: patterns/play-park.php:23
msgid "A welcoming place for little adventures and big imaginations."
msgstr "Un lugar acogedor para pequeñas aventuras y grandes ideas."

#: patterns/birthday-experiences.php:23
#: patterns/celebration-room.php:23
#: patterns/play-park.php:23
msgid "Time to celebrate"
msgstr "Tiempo para celebrar"

#: patterns/birthday-experiences.php:23
#: patterns/celebration-room.php:23
#: patterns/play-park.php:23
msgid "Gather your favourite people and make the space your own."
msgstr "Reúne a tus personas favoritas y haz tuyo el espacio."

#: patterns/birthday-experiences.php:23
#: patterns/celebration-room.php:23
#: patterns/play-park.php:23
msgid "The finishing touches"
msgstr "Los últimos detalles"

#: patterns/birthday-experiences.php:23
#: patterns/celebration-room.php:23
#: patterns/play-park.php:23
msgid "Bring your ideas to life with the details that make you smile."
msgstr "Da vida a tus ideas con los detalles que te hacen sonreír."

#: patterns/celebration-room.php
msgctxt "Pattern title"
msgid "Celebration room homepage"
msgstr "Inicio de sala de celebraciones"

#: patterns/celebration-room.php:15
msgid "Your people. Your happy place."
msgstr "Tu gente. Tu lugar feliz."

#: patterns/celebration-room.php:16
msgid "Bring everyone together in a welcoming space made for moments that matter."
msgstr "Reúne a todos en un espacio acogedor para los momentos que importan."

